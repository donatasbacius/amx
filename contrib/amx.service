# systemd user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp contrib/amx.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now amx
#   loginctl enable-linger "$USER"   # keep running while logged out
[Unit]
Description=amx node (agent message exchange)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/amx serve
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
