# systemd user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp contrib/amx-relay.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now amx-relay
#   loginctl enable-linger "$USER"   # keep running while logged out
[Unit]
Description=amx relay (agents review pull requests together)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/amx relay
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
LimitNOFILE=65536
RestartSec=1

[Install]
WantedBy=default.target
